 uint32_t plat_xruns(void) { return 0; }
+/* (AMB-1 FM6) the USB audio a phone would play: "usbaudio HZ" a tone at HZ (half full scale), "usbaudio 0" nothing */
+static float usb_hz, usb_ph;
+static int16_t usb_buf[APP_BLOCK];
+uint32_t plat_usb_audio_in(const int16_t **mono)
+{
+    uint32_t i;
+    *mono = usb_buf;
+    if (usb_hz <= 0.0f)
+        return 0;
+    for (i = 0; i < APP_BLOCK; i++) {
+        usb_ph += usb_hz / 44100.0f;
+        usb_ph -= (float)(int)usb_ph;
+        usb_buf[i] = (int16_t)(16000.0f * (usb_ph < 0.5f ? 4.0f * usb_ph - 1.0f : 3.0f - 4.0f * usb_ph));
+    }
+    return APP_BLOCK;
+}
 
