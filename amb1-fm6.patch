+    for (k = 0; k <= 8; k++) {                   /* the graticule: dotted, 8 x 8, the axes plain */
+        int32_t j;
+        for (j = 0; j <= 120; j += 4) {
+            cv_rect(60 + k * 15, 12 + j, 1, 1, grid);
+            cv_rect(60 + j, 12 + k * 15, 1, 1, grid);
