+#!/usr/bin/env python3
+# SPDX-License-Identifier: MPL-2.0
+# Copyright (C) 2026 the AMB-1 FM6 contributors
+"""The tables of the FM6 core (app/dsp/fm6_core.c, msfa from Dexed as ported to integer C in JIANT FM):
+msfa built them with double math at start-up; here they are made once, so the firmware needs no float for
+them. 32-sample blocks at 44.1 kHz. The constants are msfa's (Apache-2.0), the code is AMB-1's.
+
+    python3 tools/gen_fm6_tables.py app/dsp/fm6_tables.h
+"""
+import math
+import sys
+
+FS = 44100
+CTL = 32
+
+# msfa lfo.cc: the LFO rates 0..99 (Hz)
+LFO_HZ = [
+    0.062541, 0.125031, 0.312393, 0.437120, 0.624610, 0.750694, 0.936330, 1.125302, 1.249609, 1.436782,
+    1.560915, 1.752081, 1.875117, 2.062494, 2.247191, 2.374451, 2.560492, 2.686728, 2.873976, 2.998950,
+    3.188013, 3.369840, 3.500175, 3.682224, 3.812065, 4.000800, 4.186202, 4.310716, 4.501260, 4.623209,
+    4.814636, 4.930480, 5.121901, 5.315191, 5.434783, 5.617346, 5.750431, 5.946717, 6.062811, 6.248438,
+    6.431695, 6.564264, 6.749460, 6.868132, 7.052186, 7.250580, 7.375719, 7.556294, 7.687577, 7.877738,
+    7.993605, 8.181967, 8.372405, 8.504848, 8.685079, 8.810573, 8.986341, 9.122423, 9.300595, 9.500285,
+    9.607994, 9.798158, 9.950249, 10.117361, 11.251125, 11.384335, 12.562814, 13.676149, 13.904338, 15.092062,
+    16.366612, 16.638935, 17.869907, 19.193858, 19.425019, 20.833333, 21.034918, 22.502250, 24.003841, 24.260068,
+    25.746653, 27.173913, 27.578599, 29.052876, 30.693677, 31.191516, 32.658393, 34.317090, 34.674064, 36.416606,
+    38.197097, 38.550501, 40.387722, 40.749796, 42.625746, 44.326241, 44.883303, 46.772685, 48.590865, 49.261084]
+
+
+def table(name, ctype, vals, per):
+    out = [f"static const {ctype} {name}[{len(vals)}] = {{"]
+    for i in range(0, len(vals), per):
+        out.append("    " + ", ".join(str(v) for v in vals[i:i + per]) + ",")
+    out.append("};")
+    return out
+
+
+def main(path):
+    lf0 = 50857777                       # log2 of MIDI note 0's frequency, Q24 (fm6_core.c FM6_LOGF0)
+    semi = (1 << 24) // 12
+    lforatio = int(4437500000.0 * CTL / FS)
+    L = ["/* SPDX-License-Identifier: MPL-2.0",
+         " * generated by tools/gen_fm6_tables.py: the start-up tables of msfa (fm6_core.c), precomputed */",
+         "#pragma once",
+         "#include <stdint.h>",
+         f"#define CTL {CTL}                          /* the FM6 block, in samples */",
+         f"#define FM6_LFO_UNIT {int(CTL * 25190424 / FS + 0.5)}",
+         f"#define FM6_PENV_UNIT {int(CTL * (1 << 24) / (21.3 * FS) + 0.5)}",
+         f"#define FM6_FREQ_R {int(round(2 ** 40 / FS))}u",
+         f"#define FM6_AMS_C0 {int(round(12.2 * math.log2(math.e) * 2 ** 24))}",
+         f"#define FM6_AMS_K {int(round(0.07 / 262144 * math.log2(math.e) * 2 ** 24 * 1024))}",
+         ""]
+    # a sine, Q15, 1024 points and the first again (the operators interpolate without a wrap)
+    L += table("SINE", "int16_t", [int(round(32767 * math.sin(2 * math.pi * i / 1024))) for i in range(1025)], 12)
+    # 2^(i / 1024) - 1, Q30: Exp2's and Freqlut's mantissa
+    L += table("FM6_EXP2", "uint32_t", [int(round((1 << 30) * (2 ** (i / 1024) - 1))) for i in range(1025)], 8)
+    L += table("FM6_LFO_DELTA", "uint32_t", [int(s * lforatio) for s in LFO_HZ], 8)
+    # the DETUNE step of note mn (msfa note osc_freq), Q24 log2
+    L += table("FM6_DETUNE", "uint16_t",
+               [int(round(0.0209 * math.exp(-0.396 * ((lf0 + semi * mn) / (1 << 24))) / 7 * (lf0 + semi * mn)))
+                for mn in range(128)], 16)
+    # FINE: log2(1 + fine / 100), Q24
+    L += table("FM6_FINE", "int32_t",
+               [int(math.floor((1 << 24) / math.log(2) * math.log(1 + 0.01 * f) + 0.5)) for f in range(100)], 10)
+    with open(path, "w") as f:
+        f.write("\n".join(L) + "\n")
+
+
+if __name__ == "__main__":
+    main(sys.argv[1])
