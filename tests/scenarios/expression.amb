# Dedicated Expression page, all curated recipes, safe application, undo and persistence.
wait 300
xsavebase
battery 2
tap ENV
wait 100
expect view 1
shot voice-main.png
tap HOME
turn SELECT 5 100
wait 200
expect view 96
expect xpar0_0 0
shot expression-custom.png
listen
where
said Expr 1 Expression page
where
said Preset Custom
where
said Phrase progress
# Subtle
tap EDIT
wait 300
expect xpar0_0 24
expect xbaseunchanged 1
listen
where
said Preset Subtle
shot expression-subtle.png
# Breath
tap EDIT
wait 300
expect xpar0_0 58
expect xbaseunchanged 1
listen
where
said Preset Breath
shot expression-breath.png
