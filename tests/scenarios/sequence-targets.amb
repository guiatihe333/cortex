# Highest expression target survives 5-bit storage; LFO sequence destination is reachable.
wait 300
turn SELECT 5 150
expect view 96
turn SELECT 3 150
expect view 99
spin K2 -100
wait 600
turn K2 3 150
spin K3 -100
wait 600
turn K3 17 150
expect xpar0_10 17
tap SAVE
wait 300
reboot
wait 300
expect xpar0_10 17
storev32
reboot
wait 300
expect xpar0_10 17
expect par537 0
# Return to an old-representable target and check format 31 conversion.
turn SELECT 5 150
turn SELECT 3 150
spin K3 -100
wait 600
turn K3 12 150
expect xpar0_10 12
tap SAVE
wait 300
storev31
reboot
wait 300
expect xpar0_10 12
expect par530 35
