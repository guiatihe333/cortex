+void en_factory(int voice, int sel, int tone, uint8_t *p)
+{
+    sel = (unsigned)sel < EN_NFACT ? sel : 0;
+    if (voice == VOX_PAD)
+        pad_bank(sel, p);
+    else if (voice == VOX_BASS)
+        bass_bank(sel, p);
+    else if (sel)
+        bell_bank(sel, p);
+    else
+        bell_tone(0, (float)tone * 0.01f, tone, p);
+    p[FP_SIZE] = 0;
