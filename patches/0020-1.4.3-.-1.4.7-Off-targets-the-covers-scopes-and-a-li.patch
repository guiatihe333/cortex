+static void text_fit(int32_t cx, int32_t y, const char *s, uint16_t c)
+{
+    char b[16];
+    int n = 0, k;
+    for (k = 0; s[k] && n < 15; k++)
+        if (s[k] != ' ' || (n && b[n - 1] != ' '))
+            b[n++] = s[k];
