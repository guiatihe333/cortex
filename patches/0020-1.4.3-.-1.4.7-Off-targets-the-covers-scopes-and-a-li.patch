+        n--;
+    b[n] = 0;
+    if (text_w(&FONT_B, b) <= 56) {
+        text_c(cx, y, &FONT_B, b, c);
+        return;
+    }
+    while (n > 1 && text_w(&FONT_XS, b) > 57)
+        b[--n] = 0;
+    text_c(cx, y + 2, &FONT_XS, b, c);
+}
