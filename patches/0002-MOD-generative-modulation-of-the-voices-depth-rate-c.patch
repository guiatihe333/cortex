+                en_set(P_MCHAOS, k);
+                peak = 0.0f;
+                run(3.0f);
+                CHECK(!bad && peak < 1.0f, "MOD target %d chaos %d: peak %f", d, k, (double)peak);
+            }
+        en_set(P_MDEPTH, 0);
+    }
