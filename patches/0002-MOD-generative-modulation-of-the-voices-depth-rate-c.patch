+        CHECK(moved == EN_NMOD, "MOD: %d of %d generators moved", moved, EN_NMOD);
+        CHECK(apart > 30, "MOD: the pad's first two voices together (%d of 40 apart)", apart);
+        for (d = 0; d < EN_NMODDEST; d++)
