+            CHECK(en_mod[g] == 0.0f, "MOD at depth 0: generator %d at %f", g, (double)en_mod[g]);
+        en_set(P_MDEPTH, 100);
+        en_set(P_MRATE, 80);
+        en_set(P_MCHAOS, 50);
+        for (g = 0; g < EN_NMOD; g++)
+            lo[g] = hi[g] = en_mod[g];
+        for (k = 0; k < 40; k++) {
+            run(0.25f);
+            for (g = 0; g < EN_NMOD; g++) {
+                lo[g] = en_mod[g] < lo[g] ? en_mod[g] : lo[g];
+                hi[g] = en_mod[g] > hi[g] ? en_mod[g] : hi[g];
+                out += en_mod[g] < -1.0f || en_mod[g] > 1.0f || en_mod[g] != en_mod[g];
