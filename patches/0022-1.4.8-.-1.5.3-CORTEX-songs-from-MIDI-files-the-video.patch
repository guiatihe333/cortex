+    }
+    return sum > 0.0f ? in / sum + 0.2f * v[((root - t) % 12 + 12) % 12] / mx : 0.0f;
+}
+static float rl_snap(float s, int spl)           /* Key sync Tape: SPEED's nearest transposition into the garden's key */
