+        return;
+    while (n-- > 0) {
+        if (yy0 >= y0 && yy0 < y0 + h) {
+            int xs = x0 + vrow_o[yy0 - y0];
+            xs = xs < 0 ? xs + 240 : xs >= 240 ? xs - 240 : xs;
