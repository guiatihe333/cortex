+ * root counts a little more (a key, not only a scale). 0 .. ~1.2 */
+static float rl_fit(const float *v, int t)
+{
+    const int root = par[P_ROOT];
+    float in = 0.0f, sum = 0.0f, mx = 0.0f;
+    int pc;
+    for (pc = 0; pc < 12; pc++) {
+        const int q = ((pc + t) % 12 + 12) % 12;
+        sum += v[pc];
+        mx = fm_maxf(mx, v[pc]);
+        if (pool >> ((q - root + 12) % 12) & 1u)
