+static int16_t vrow_o[MAIN_H];                  /* the band's rows' offsets (SYNC, SLICE): the sharp lines move with
+                                                 * them */
+static void vis_seg(int x0, int yy0, int x1, int yy1, uint16_t c, int y0, int h)   /* a sharp line, in the band */
