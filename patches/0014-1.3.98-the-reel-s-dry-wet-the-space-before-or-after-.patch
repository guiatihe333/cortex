+    int32_t dy, hw = r;
+    for (dy = 0; dy <= r; dy++) {
+        while (hw > 0 && hw * hw + dy * dy > r * r)
+            hw--;
+        cv_rect(cx - hw, cy - dy, 2 * hw + 1, 1, c);
+        if (dy)
+            cv_rect(cx - hw, cy + dy, 2 * hw + 1, 1, c);
+    }
