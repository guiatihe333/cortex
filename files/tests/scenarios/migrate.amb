# a project saved by 0.9 before the layer pages (format 3) loads with its settings; the bass's and
# the pulse's new ones come from each piece's recipe
wait 300
turn PRESET 4
expect piece 4
storev3 33
reboot
wait 300
expect piece 4
expect par0 33
expect par23 0
expect par24 10
expect par25 45
expect par26 30
expect par27 70
tap SAVE
reboot
wait 300
expect par0 33
expect par26 30
# (each voice's first modulator from Night Bus's recipe: depth 35, a walk, Metal)
expect par32 35
expect par34 6
expect par35 2
expect par116 35
# a project of the first FM6 build (format 5: one MOD for all three voices) loads with it as each voice's first
# modulator; the patches as they were
storev5 55
reboot
wait 300
expect piece 4
expect par0 33
expect par32 55
expect par74 55
expect par116 55
expect par34 7
expect par35 3
expect par119 3
expect par28 0
expect par31 0
expect par33 31
# a project of 1.3.91 (format 6: each voice its own MOD and FM edits) loads with its MOD as the first modulator and
# the pad's edits baked into its patch (Night Bus's Rhodes: feedback 0 + 2; OP6, a modulator at x1, x2)
storev6 44
reboot
wait 300
expect piece 4
expect par32 44
expect par116 44
expect par34 4
expect par35 5
expect par30 1
expect par72 0
expect pat0_135 2
expect pat0_18 2
# a project of 1.3.93 (format 7) loads as it was, its patches too (the pad's edits above), each voice playing as AMB-1
# does (ENV, par156 on: 0) with its GATE at the default (70)
storev7
reboot
wait 300
expect piece 4
expect par32 44
expect par116 44
expect pat0_135 2
expect pat0_18 2
expect par156 0
expect par157 70
