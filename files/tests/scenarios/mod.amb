# each voice's own pages, in three groups: its page button pressed again goes to VOICE, again to OPERATOR, again to
# MOD, and back; SELECT steps through a group's pages. parN: amb.h (P_VOX 30, a voice's block of 42: OWN, INDEX, five
# modulators of 8); patV_OFF: voice V's patch byte (amb.h EP_*). Views: the pad's own 11..25, the bells' 26.., the
# bass's 41..
wait 300
tap ENV
wait 100
expect view 1
tap ENV
wait 100
expect view 11
shot pad_voice.png
# the patch: the next of the pad's own (Voices), as loaded
expect par22 0
turn K1 1 10
expect par22 1
expect par30 0
# the algorithm: 5 -> 7 (an edit: the patch the voice's own, OWN)
turn K2 2 10
expect pat0_134 6
expect par30 1
# OPERATOR: OP3's level, 80 -> 70 (OP3's bytes from 63: its level at 79)
tap ENV
wait 100
expect view 17
shot pad_op.png
turn K1 2 10
spin K4 -10
expect pat0_79 70
# OP Env: its stage 2's rate, 30 -> 35 (at 64)
turn SELECT 1 100
expect view 18
turn K2 1 10
spin K3 5
expect pat0_64 35
shot pad_openv.png
# MOD: the first modulator's depth, Garden's 20 -> 23 (the bells' and the bass's untouched); the second's target
# (Garden's recipe: Pitch, 5, to 14)
tap ENV
wait 100
expect view 23
shot mod.png
turn K3 3 10
expect par32 23
expect par74 20
expect par116 20
turn K1 1 10
turn K2 9 100
expect par43 14
turn SELECT 1 100
expect view 24
# back to the pad's page
tap ENV
wait 100
expect view 1
# the bells: VOICE, their patch (Vibes); the bass: VOICE, Index +2 dB
tap ARP
wait 100
tap ARP
wait 100
expect view 26
turn K1 1 10
expect par28 7
tap LFO
wait 100
tap LFO
wait 100
expect view 41
turn K4 2 10
expect par115 2
# another voice's button from a voice's page: that voice's own first page
tap ARP
wait 100
expect view 2
tap SEQ
wait 100
expect view 6
# SEQ again: the reel's pages, Tape, Gene, Deck, Tape Mod 1 and 2, round
tap SEQ
wait 100
expect view 7
tap SEQ
wait 100
expect view 8
tap SEQ
wait 100
expect view 9
tap SEQ
wait 100
expect view 10
tap SEQ
wait 100
expect view 6
tap HOME
wait 100
tap HOME
wait 100
expect view 0
# SELECT walks the layers' pages only (Setup, then the reel's five, the last)
tap GLO
wait 100
turn SELECT 6 100
expect view 10
wav mod.wav
wait 20000
wavstop
expect peak_db_max -0.5
# kept with the piece: the settings and the patch
turn PRESET 1
turn PRESET -1
expect par28 7
expect par32 23
expect pat0_79 70
expect par30 1
tap SAVE
reboot
wait 300
expect pat0_79 70
expect pat0_134 6
expect par30 1
expect par32 23
# a bank over SysEx (bank 3); the bells' Patch past their own six: its first voice (TEST 01), as loaded
bankfake 2
wait 100
tap ARP
wait 100
tap ARP
wait 100
expect view 26
turn K1 11 10
expect par28 82
expect par72 0
expect pat1_145 84
shot bank_voice.png
# a DX7 single voice (Dexed's send) into the voice on the screen, the bells: edited (OWN), named DX7 VOICE
dx7voice
wait 100
expect par72 1
expect pat1_145 68
# MIDI CC in: the bass's first modulator's depth (channel 3, CC 21), Index (CC 20); the pad's OP1 level by NRPN
midi B2 15 7F
midi B2 14 7F
wait 50
expect par116 100
expect par115 24
midi B0 63 00
midi B0 62 79
midi B0 06 32
wait 50
expect pat0_121 50
# MIDI CC out: a knob turned (the bells' INDEX, CC 20 on channel 2)
expect view 26
out
turn K4 24 100
expect par73 24
expect_out USB B1 14 7F
# Play, the PATCH group's second page: the pad plays its patch's envelopes (ENV Patch, par156), held a shorter GATE
tap HOME
wait 100
tap ENV
wait 100
tap ENV
wait 100
expect view 11
turn SELECT 1 100
expect view 12
shot pad_play.png
turn K1 1 10
expect par156 2
turn K2 -2 10
expect par157 68
wait 3000
